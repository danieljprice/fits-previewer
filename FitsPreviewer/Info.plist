			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<!-- Same dynamic types as the Quick Look extensions. Alternate rank keeps DS9 as the opener. -->
			<key>LSItemContentTypes</key>
			<array>
				<string>gov.nasa.gsfc.fits</string>
				<string>gov.nasa.gsfc.fits-gzip</string>
