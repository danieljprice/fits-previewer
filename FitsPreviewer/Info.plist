			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fits</string>
					<string>fit</string>
					<string>fts</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>gov.nasa.gsfc.fits-gzip</string>
			<key>UTTypeDescription</key>
			<string>gzip-compressed FITS file</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>org.gnu.gnu-zip-archive</string>
			</array>
			<!-- Compound extension, so this does not claim every .gz file. -->
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>fits.gz</string>
					<string>fit.gz</string>
					<string>fts.gz</string>
				</array>
			</dict>
		</dict>
	</array>
